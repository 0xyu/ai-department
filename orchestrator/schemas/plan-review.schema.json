{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xyu/aco/schemas/v1/plan-review.schema.json",
  "title": "ACO plan review (v1)",
  "description": "Stage 2 independent plan review (implementation plan section 10.3). Every object lists all of its properties as required and forbids others, so the schema is valid for strict structured output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "dimension_ratings", "requirement_coverage", "previous_findings", "new_findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["pass", "revise"]},
    "summary": {"type": "string"},
    "dimension_ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "rating", "notes"],
        "properties": {
          "dimension": {"type": "string", "enum": ["architecture", "technical_approach", "coverage", "dependencies", "risks", "phase_quality", "acceptance_criteria", "quality_gates"]},
          "rating": {"type": "string", "enum": ["sound", "concerns", "unsound"]},
          "notes": {"type": "string"}
        }
      }
    },
    "requirement_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["req_id", "status", "phases", "notes"],
        "properties": {
          "req_id": {"type": "string"},
          "status": {"type": "string", "enum": ["covered", "partial", "missing"]},
          "phases": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "previous_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "note"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["resolved", "unresolved", "dispute_accepted", "dispute_rejected"]},
          "note": {"type": "string"}
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "dimension", "location", "title", "description", "required_change"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
          "dimension": {"type": "string", "enum": ["architecture", "technical_approach", "coverage", "dependencies", "risks", "phase_quality", "acceptance_criteria", "quality_gates"]},
          "location": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "required_change": {"type": "string"}
        }
      }
    }
  }
}
